{
  "name": "draftmd",
  "productName": "DraftMD",
  "version": "0.1.1",
  "description": "The open-source macOS AI Markdown editor",
  "main": "dist/main/index.js",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:packaged": "playwright test --config playwright.packaged.config.ts",
    "test:windows": "playwright test --config playwright.windows.config.ts",
    "check:theme-colors": "node scripts/check-theme-colors.mjs",
    "dist:mac": "electron-vite build && npm run prepare:native-packages && cd .build/package && ../../node_modules/.bin/electron-builder --config electron-builder.yml --config.mac.identity=null --config.mac.notarize=false --mac --universal --publish never",
    "dist:win": "node scripts/dist-windows.js",
    "postinstall": "electron-builder install-app-deps",
    "test:security": "vitest run --config vitest.security.config.ts && playwright test --config playwright.security.config.ts",
    "test:performance": "DRAFTMD_PERFORMANCE_OUTPUT=artifacts/performance/workspace.json vitest run --config vitest.performance.config.ts && playwright test --config playwright.performance.config.ts",
    "prepare:native-packages": "node scripts/prepare-native-packages.js",
    "dist:mac:signed": "electron-vite build && npm run prepare:native-packages && cd .build/package && ../../node_modules/.bin/electron-builder --config electron-builder.yml --mac --universal --publish never",
    "verify:universal": "node scripts/verify-universal.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@codemirror/commands": "6.10.2",
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "6.40.0",
    "@milkdown/kit": "^7.19.2",
    "@milkdown/plugin-math": "^7.5.9",
    "@napi-rs/keyring": "^2.0.0",
    "better-sqlite3": "^13.0.3",
    "diff": "^9.0.0",
    "electron-updater": "^6.8.9",
    "katex": "^0.16.47",
    "mdast-util-from-markdown": "^2.0.3",
    "mermaid": "^11.17.0",
    "node-diff3": "^3.2.1",
    "openai": "^7.8.0",
    "remark-breaks": "^4.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/diff": "^7.0.2",
    "@types/katex": "^0.16.8",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "0.25.12",
    "typescript": "^7.0.2",
    "vite": "^7.1.3",
    "vitest": "^4.1.11",
    "zod": "^4.5.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zhnpeng/DraftMD.git"
  },
  "homepage": "https://github.com/zhnpeng/DraftMD#readme",
  "bugs": {
    "url": "https://github.com/zhnpeng/DraftMD/issues"
  }
}
